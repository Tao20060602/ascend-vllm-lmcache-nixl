# 版本锚点(A 臂:vLLM + LMCache-Ascend + NIXL posix)
# 本文件是所有脚本的唯一版本来源;改版本只改这里,并在报告里记录变更。
# 上机前必须按所选 tag 的官方文档复核版本矩阵,不同 release 的矩阵互不兼容。
#
# 910B(A2) 注意(2026-11-24):
#   - A2 是 vllm-ascend pip 轮子的官方支持平台,可 pip 直装(源码路径仍通用);
#   - CANN 9.0.x 镜像 → 维持 VLLM_ASCEND_REF=v0.30.0(torch 2.9.0 / torch_npu 2.9.0.post2);
#   - CANN 8.5.x 镜像 → v0.13.x 线(torch 2.7),但 LMCache-Ascend 要求 vLLM>=0.23,A 臂不可行,
#     必须换 CANN 9.0.x 镜像或容器内升级 CANN(见 PLAN-910B.md 选镜像原则)。

# vllm-ascend 稳定线,匹配 CANN 9.0.0 镜像(矩阵参考: CANN 9.0.0 / torch 2.9.0 / torch_npu 2.9.0.post2)
VLLM_ASCEND_REF=v0.30.0

# 锁定的 vllm 版本。留空 = 安装脚本自动从 vllm-ascend/pyproject.toml 解析;
# 解析失败时脚本会报错退出,此时按该 vllm-ascend tag 文档手工填入(形如 0.30.0)。
VLLM_REF=

# LMCache-Ascend 兼容矩阵(来自官方 README):
#   LMCache-Ascend main 分支 <-> LMCache dev 分支
#   LMCache-Ascend v0.5.6     <-> LMCache v0.5.6
LMCACHE_ASCEND_REF=main
LMCACHE_REF=dev

# NIXL:留空 = pip 安装最新发布版;填 tag 名(如 v0.6.0)= 源码构建。
# 注意:两个框架对 nixl 版本都有约束,冲突时以各框架文档为准并记录进报告。
NIXL_REF=

# 冒烟模型(ModelScope 仓 ID)
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_DIR_NAME=qwen2.5-0.5b
